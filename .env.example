# ---- 202-maktab environment configuration (example) ----
# Copy to .env.local for development. NEVER commit real secrets.
# Every value below is EMPTY on purpose — `npm run check:secrets` fails the
# build if a non-empty credential ever lands in this file or in git history.

NODE_ENV=development
PORT=3000

# Comma-separated origins allowed to call the API cross-origin.
# Empty/unset = same-origin only (no CORS headers are emitted).
APP_ORIGIN=
API_ORIGIN=

# debug | info | warn | error
LOG_LEVEL=info

# memory | redis
CACHE_PROVIDER=memory
REDIS_URL=

# Observability
METRICS_ENABLED=false
# OpenAPI docs at /api/docs — default true outside production
# API_DOCS_ENABLED=true

# Contact form limits
CONTACT_MAX_BYTES=8192

# Rate limits (requests per window)
RATE_LIMIT_PUBLIC_READ_MAX=240
RATE_LIMIT_PUBLIC_READ_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=120
RATE_LIMIT_ADMIN_WINDOW_MS=60000

# Spam filter: null | heuristic
SPAM_FILTER=heuristic

# ---- data provider & database (Supabase PostgreSQL) ----
# json     = in-memory store seeded from src/data/* (dev/preview only).
#            The admin panel works but changes reset on restart.
# supabase = PostgreSQL via Supabase (production).
DATA_PROVIDER=json

# ============================================================================
# SERVER-ONLY — never expose these to the browser, never commit real values.
# Supabase dashboard → Project Settings → API.
# ============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable apikey used by the SSR auth client (signInWithPassword / getUser).
# Recommended. If omitted, the server falls back to the service-role key for
# AUTH CALLS ONLY and logs a one-time warning.
SUPABASE_ANON_KEY=

# ============================================================================
# PUBLIC — safe to ship in the browser bundle (publishable by design; grants no
# database access because RLS is default-deny).
# Optional in this app: no browser code talks to PostgREST directly.
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Phase 4: admin login brute-force protection ----
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000

# ---- Phase 4: media upload cap (bytes, default 8 MiB) ----
MEDIA_MAX_BYTES=8388608

# ---- LOCAL DEV / TEST FIXTURE ONLY ----
# Ignored unless DATA_PROVIDER != supabase. Seeds the in-memory admin_users
# table with `{ userId, email, role, isActive }` entries so a local Supabase
# Auth instance (or the test double in tests/helpers/) can be mapped to an
# admin. Contains NO credentials — passwords live in Supabase Auth — so on its
# own it grants nothing.
ADMIN_USERS_SEED=

# NOTE: the Phase 3 `ADMIN_DEV_TOKEN` / `x-admin-dev-token` development gate was
# REMOVED in Phase 4. It no longer exists and grants no access.
