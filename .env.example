# ---- 202-maktab environment configuration (example) ----
# Copy to .env.local for development. NEVER commit real secrets.

NODE_ENV=development
PORT=3000

# Comma-separated origins allowed to call the API cross-origin.
# Empty/unset = same-origin only (no CORS headers are emitted).
APP_ORIGIN=
API_ORIGIN=

# debug | info | warn | error
LOG_LEVEL=info

# memory | redis  (redis adapter lands in Phase 3; falls back to memory with a warning)
CACHE_PROVIDER=memory
REDIS_URL=

# Observability
METRICS_ENABLED=false
# OpenAPI docs at /api/docs — default true outside production
# API_DOCS_ENABLED=true

# Contact form limits
CONTACT_MAX_BYTES=8192

# Rate limits (requests per window)
RATE_LIMIT_PUBLIC_READ_MAX=240
RATE_LIMIT_PUBLIC_READ_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_MS=60000

# Spam filter: null | heuristic
SPAM_FILTER=heuristic

# ---- Phase 3: data provider & database (Supabase PostgreSQL) ----
# json     = in-memory store seeded from src/data/* (default; dev/preview).
#            Admin panel works but changes reset on restart.
# supabase = PostgreSQL via Supabase (requires the two values below).
DATA_PROVIDER=json

# SERVER-SIDE ONLY. Never expose the service-role key to the browser,
# never commit real values. Get them from: Supabase dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are INTENTIONALLY
# unused: this app forbids direct database access from frontend components.
# All access flows through /api/v1/* (controller → service → repository).

# ---- Phase 3: development-only admin access (NOT production auth) ----
# When set, /api/v1/admin/* requires header: x-admin-dev-token: <value>
# Production build WITHOUT this value disables the admin API (503).
# Min length 16. Phase 4 replaces this with real authentication.
ADMIN_DEV_TOKEN=
RATE_LIMIT_ADMIN_MAX=120
RATE_LIMIT_ADMIN_WINDOW_MS=60000
