  "private": true,
  "description": "202-sonli umumiy o'rta ta'lim maktabi rasmiy sayti — Phase 1 frontend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/api.test.mjs tests/admin.test.mjs",
    "test:full": "next build && node --test tests/api.test.mjs tests/admin.test.mjs",
    "load:test": "node scripts/load-test.mjs",
