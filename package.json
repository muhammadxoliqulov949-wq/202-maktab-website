{
  "name": "202-maktab-website",
  "version": "0.1.0",
  "private": true,
  "description": "202-sonli umumiy o'rta ta'lim maktabi rasmiy sayti — Phase 4 (Supabase Auth + admin authorization)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test --test-concurrency=1 tests/api.test.mjs tests/auth.test.mjs tests/admin.test.mjs",
    "test:full": "next build && npm test",
    "load:test": "node scripts/load-test.mjs",
    "db:migrate": "echo 'SQL migratsiyalarni qollang: supabase/migrations/*.sql (SQL editor yoki supabase CLI)' && ls supabase/migrations/",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:dry": "tsx scripts/seed.ts --dry-run",
    "db:seed:sql": "tsx scripts/seed-sql.ts",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "admin:user": "node scripts/admin-user.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:migrate:apply": "node scripts/apply-migration.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autocannon": "^7.15.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
